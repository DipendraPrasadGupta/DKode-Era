generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id      Int      @id @default(autoincrement())
  num     String
  icon    String
  title   String
  titleNp String
  desc    String
  tags    String   // Stored as JSON string
  price   String
  pricing String   @default("[]") // Stored as JSON string of PricingTier[]
}

model ServiceOrder {
  id          Int      @id @default(autoincrement())
  serviceName String
  tierName    String
  price       String
  userName    String
  userEmail   String
  userPhone   String
  message     String
  status      String   @default("Pending") // Pending, Processing, Completed, Cancelled
  createdAt   DateTime @default(now())
}

model FAQ {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
}


model TeamMember {
  id     Int    @id @default(autoincrement())
  icon   String
  role   String
  name   String
  desc   String
  skills String // Stored as JSON string
}

model Testimonial {
  id    Int    @id @default(autoincrement())
  stars Int
  quote String
  icon  String
  name  String
  biz   String
}

model ContactMessage {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String
  email         String
  company       String
  serviceNeeded String
  budget        String
  timeline      String
  message       String
  createdAt     DateTime @default(now())
}

model AboutPage {
  id          Int    @id @default(autoincrement())
  hero        String @default("{}") // JSON: { badge, title, subtitle, gradient }
  stats       String @default("[]") // JSON: { num, label, icon }[]
  story       String @default("{}") // JSON: { eyebrow, title, paragraphs[] }
  values      String @default("[]") // JSON: { icon, title, desc, color }[]
  milestones  String @default("[]") // JSON: { year, month, title, desc, icon }[]
  teamMembers String @default("[]") // JSON: { name, role, icon, bio, skills[], color }[]
  cta         String @default("{}") // JSON: { title, subtitle, primaryHref, primaryLabel, secondaryHref, secondaryLabel }
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model ProductEcosystem {
  id          Int      @id @default(autoincrement())
  pillName    String
  badge       String
  title       String
  description String
  image       String   @default("")
  demoUrl     String   @default("")
  category    String   @default("Product")
  tech        String   @default("[]") // JSON: string[]
  order       Int      @default(0)
  highlight   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Blog {
  id           Int           @id @default(autoincrement())
  title        String
  slug         String        @unique
  excerpt      String
  content      String
  coverImage   String        @default("")
  category     String        @default("Engineering")
  tags         String        @default("")
  author       String        @default("D-Kode Era Team")
  authorRole   String        @default("Software Engineering")
  authorAvatar String        @default("")
  readTime     String        @default("5 min read")
  published    Boolean       @default(true)
  featured     Boolean       @default(false)
  allowModal   Boolean       @default(true)
  views        Int           @default(0)
  likes        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  comments     BlogComment[]
}


model BlogComment {
  id        Int      @id @default(autoincrement())
  blogId    Int
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  name      String
  email     String   @default("")
  avatar    String   @default("")   // first-letter avatar color hint
  content   String
  approved  Boolean  @default(true) // auto-approve; set false if you want moderation
  createdAt DateTime @default(now())
}

model Career {
  id               Int      @id @default(autoincrement())
  title            String
  department       String   @default("Engineering")
  type             String   @default("Full-time")
  location         String   @default("Butwal / Remote")
  experience       String   @default("2+ Years")
  salary           String   @default("Competitive / Negotiable")
  description      String
  responsibilities String   @default("[]") // JSON array string
  requirements     String   @default("[]") // JSON array string
  benefits         String   @default("[]") // JSON array string
  tags             String   @default("[]") // JSON array string e.g. ["React", "TypeScript"]
  color            String   @default("#06b6d4")
  published        Boolean  @default(true)
  order            Int      @default(0)
  heroDesc         String?  @default("")
  whyJoinItems     String?  @default("")
  applySteps       String?  @default("")
  companyTagline   String?  @default("")
  companyFounded   String?  @default("")
  companyLocation  String?  @default("")
  companyFocus     String?  @default("")
  companyCulture   String?  @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}


model JobApplication {
  id          Int      @id @default(autoincrement())
  careerId    Int
  careerTitle String
  department  String   @default("")
  name        String
  email       String
  phone       String   @default("")
  portfolio   String   @default("")
  cvUrl       String   @default("") // uploaded file URL
  resumeLink  String   @default("") // cloud link fallback
  coverNote   String
  status      String   @default("New")  // New, Reviewing, Shortlisted, Rejected, Hired
  createdAt   DateTime @default(now())
}
model Notification {
  id         Int                      @id @default(autoincrement())
  subject    String
  body       String
  channel    String                   @default("email") // "email" | "in-app" | "both"
  targetType String                   @default("all")   // "all" | "selected"
  sentBy     String                   @default("admin")
  status     String                   @default("sent")  // "sent" | "draft" | "failed"
  createdAt  DateTime                 @default(now())
  recipients NotificationRecipient[]
}

model NotificationRecipient {
  id             Int          @id @default(autoincrement())
  notificationId Int
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  email          String
  name           String       @default("")
  status         String       @default("pending") // "pending" | "sent" | "failed"
  sentAt         DateTime?
}

// Subscriber list — contacts, applicants who opted-in
model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String   @default("")
  source    String   @default("contact") // "contact" | "applicant" | "manual"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
